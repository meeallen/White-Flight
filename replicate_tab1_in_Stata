*** do 021-Table01v241116
 ** Table 1: Descriptive Statistics
 ** Compatibility version for missing d_whiteflight_balanced.dta

capture log close _all
clear all
set matsize 800
set scheme plotplain
set mem 400000k
set linesize 100
set more off

local log "`c(tmpdir)'021-Table01v241116.log"
local dsold "d_whiteflight_balanced"
local tag "021-Table01v241116"
local num "021"

****************************************************
* Create temporary workspace
****************************************************

local workdir "`c(tmpdir)'whiteflight_table1_work"
capture mkdir "`workdir'"
capture mkdir "`workdir'/data"

cd "`workdir'"

****************************************************
* Download the available public enrollment dataset
****************************************************

display as text "Downloading available public enrollment dataset..."

capture copy ///
    "https://raw.githubusercontent.com/HigherEdData/White-Flight/main/data/d_hsi_white_enrollment_final3.dta" ///
    "`workdir'/d_hsi_white_enrollment_final3.dta", replace

capture confirm file "`workdir'/d_hsi_white_enrollment_final3.dta"

if _rc {
    display as error "Could not download d_hsi_white_enrollment_final3.dta."
    display as error "This may be an internet or Virtual Sites issue."
    exit 601
}

****************************************************
* Make the missing Table 1 dataset name as an alias
****************************************************

copy "`workdir'/d_hsi_white_enrollment_final3.dta" ///
     "`workdir'/d_whiteflight_balanced.dta", replace

copy "`workdir'/d_hsi_white_enrollment_final3.dta" ///
     "`workdir'/data/d_whiteflight_balanced.dta", replace

display as result "Created temporary alias:"
display as result "`workdir'/d_whiteflight_balanced.dta"

****************************************************
* Open dataset using the author's expected name
****************************************************

use "`dsold'", clear

****************************************************
* Recreate balanced-panel variables if absent
****************************************************

capture confirm variable missingpanel
if _rc {
    gen missingpanel = .
}

capture confirm variable maxyear
if _rc {
    bysort unitid: egen maxyear = max(year)
}

capture confirm variable minyear
if _rc {
    bysort unitid: egen minyear = min(year)
}

capture confirm variable missingpanelall
if _rc {
    bysort unitid: egen missingpanelall = min(missingpanel)
}

capture confirm variable alwaystreated
if _rc {
    bysort unitid: egen alwaystreated = min(hispserve)
}

capture confirm variable evertreated
if _rc {
    bysort unitid: egen evertreated = max(hispserve)
}

****************************************************
* Check for variables Table 1 needs
****************************************************

local needed ///
    hispserveyeardiff ///
    cpopwh cpopbl cpophi cpopas cpopam ///
    populationwh populationbl populationhi populationas populationam ///
    hispserveyear pcttefhispt fips ///
    teftotlt admitpct ftfefwhitt ///
    lnftfefwhitt lnftfeftotlt ///
    unitid year hispserve ///
    missingpanel missingpanelall maxyear minyear alwaystreated evertreated

local missing ""

foreach v of local needed {
    capture confirm variable `v'
    if _rc {
        local missing "`missing' `v'"
    }
}

if "`missing'" != "" {
    display as error "The dataset opened, but these Table 1 variables are missing:"
    display as error "`missing'"
    display as text "This means we need to reconstruct these variables before Table 1 can run."
    exit 111
}

log using "`log'", text replace

quietly {

    gen switchers = (hispserveyeardiff<.)
    foreach var of varlist cpopwh cpopbl cpophi cpopas cpopam populationwh populationbl populationhi populationas populationam {
        qui gen k`var' = `var' / 1000
    }
    rename kpopulationwh kpopwh 
    rename kpopulationbl kpopbl 
    rename kpopulationhi kpophi 
    rename kpopulationas kpopas 
    rename kpopulationam kpopam

