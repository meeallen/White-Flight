noisily pubrow _Iregion6_2,   label("  Mid-Atlantic")                   type(decimal)
noisily pubrow _Iregion6_3,   label("  South")                          type(decimal)
noisily pubrow _Iregion6_4,   label("  Midwest")                        type(decimal)
