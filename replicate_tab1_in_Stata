    qui lab var teftotlt "undergrads"
    qui lab var admitpct "Admissions rate (%)"
    qui lab var ftfefwhitt "Fulltime frosh enrol"

*** New restrictions // 11/17/2024

    // drop if lnftfefwhitt==. | lnftfefhispt==. // old
    drop if lnftfefwhitt==.
    drop if year==1990 & hispserve==1
    // gen missingpanel=. // already defined 24/11/17
    sort unitid year
    // bysort unitid: egen maxyear=max(year) // already defined 24/11/17 
    // bysort unitid: egen minyear=min(year) // already defined 24/11/17
    bysort unitid (year): replace missingpanel=1 if year[_n-1]!=year-1 | lnftfefwhitt==. | lnftfeftotlt==.
    replace missingpanel=. if year==1990 & lnftfefwhitt!=. & lnftfeftotlt!=.
    // bysort unitid: egen missingpanelall=min(missingpanel) // already defined 24/11/17
    replace missingpanelall=1 if maxyear!=2019 | minyear !=1990
    // bysort unitid: egen alwaystreated=min(hispserve) // already defined 24/11/17
    // bysort unitid: egen evertreated=max(hispserve) // already defined 24/11/17
    drop if alwaystreated==1
    drop if missingpanelall==1
    xtset unitid year

*** Show counts for switchers and non-switchers

  * Switcher schools
    qui count if hispserveyear==year
    local N1 = r(N)

  * Switcher schools/years
    qui count if hispserveyear!=.
    local N2 = r(N)

  * Non-switcher schools
    qui count if minyear==year & hispserveyear==.
    local N3 = r(N)

  * Non-switcher schools/years
    qui count if hispserveyear==.
    local N4 = r(N)

    foreach num of numlist 1 2 3 4 {
        di
        if `num'==1 {
            dis "===> `N1' switcher schools" 
        }
        if `num'==2 {
            display "===> `N2' switcher schools/years"
        }
        if `num'==3 {
            dis "===> `N3' non-switcher schools"
        }
        if `num'==4 {
            display "===> `N4' non-switcher schools/years"
        }
    }

*** Create Table 1

****************************************************
* Create publication-style Table 1 display
****************************************************

set linesize 120

capture program drop pubrow
program define pubrow
    syntax varname, LABEL(string) TYPE(string)

    quietly summarize `varlist' if switchers == 1
    local mn1 = r(mean)
    local sd1 = r(sd)
    local n1  = r(N)

    quietly summarize `varlist' if switchers == 0
    local mn2 = r(mean)
    local sd2 = r(sd)
    local n2  = r(N)

    if "`type'" == "decimal" {
        local mn1s : display %10.2f `mn1'
        local sd1s : display %10.2f `sd1'

        if `n2' == 0 {
            local mn2s "        --"
            local sd2s "        --"
        }
        else {
            local mn2s : display %10.2f `mn2'
            local sd2s : display %10.2f `sd2'
        }
    }

    if "`type'" == "integer" {
        local mn1s : display %10.0fc `mn1'
        local sd1s : display %10.0fc `sd1'

        if `n2' == 0 {
            local mn2s "        --"
            local sd2s "        --"
        }
        else {
            local mn2s : display %10.0fc `mn2'
            local sd2s : display %10.0fc `sd2'
        }
    }

    if "`type'" == "pop" {
        local mn1s : display %10.0fc (`mn1' * 1000)
        local sd1s : display %10.0fc (`sd1' * 1000)

        if `n2' == 0 {
            local mn2s "        --"
            local sd2s "        --"
        }
        else {
            local mn2s : display %10.0fc (`mn2' * 1000)
            local sd2s : display %10.0fc (`sd2' * 1000)
        }
    }

    display as text _col(2) "`label'" ///
        _col(39) as result "`mn1s'" ///
        _col(52) as result "`sd1s'" ///
        _col(68) as result "`mn2s'" ///
        _col(81) as result "`sd2s'"
end


noisily display as text ""
noisily display as text "Table 1. Demographic Characteristics for Four-Year Public Universities in the Analyses."
noisily display as text "{hline 94}"
noisily display as text _col(39) "HSI switcher schools" _col(68) "Nonswitcher schools"
noisily display as text _col(39) "--------------------" _col(68) "-------------------"
noisily display as text _col(43) "M" _col(56) "SD" _col(72) "M" _col(84) "SD"
noisily display as text "{hline 94}"

noisily pubrow teftotlt,      label("Total enrollment")                 type(integer)
noisily pubrow hispserveyear, label("First year HSI")                   type(decimal)

