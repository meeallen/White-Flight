noisily pubrow kpophi,        label("  Hispanic")                       type(pop)
noisily pubrow kpopas,        label("  Asian")                          type(pop)
noisily pubrow kpopam,        label("  American Indian")                type(pop)

noisily display as text "{hline 94}"
noisily display as text _col(2) "N schools"       _col(45) as result %10.0fc `N1' _col(74) as result %10.0fc `N3'
