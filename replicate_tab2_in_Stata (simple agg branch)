********************************************************************************
* Replicate Table 2
* White First-Year Panel DiD Estimates
* White Flight in Public Higher Education?
*
* Quiet, replication-faithful version
*
* Default Results-window output:
*   - brief startup/sample summary
*   - model progress messages
*   - interim TWFE/CSDID table
*   - final five-model Table 2
*   - brief timer and output-location summary
********************************************************************************

quietly {

    clear all
    set more off
    set linesize 150
    set varabbrev off

    ****************************************************************************
    * User settings
    ****************************************************************************

    local project "K:\White Flight Data for Stata"

    * 0 = quick pipeline test with 5 placebo repetitions
    * 1 = final article-style run with 500 placebo repetitions
    local finalrun 0

    local reps 5
    if `finalrun' == 1 {
        local reps 500
    }

    * Optional diagnostics from the authors' file:
    * preliminary agg(group), tabulations, and xtdidregress
    local run_author_diagnostics 0

    ****************************************************************************
    * Local temporary workspace
    ****************************************************************************

    local workdir "`c(tmpdir)'whiteflight_t2_work"

    capture mkdir "`workdir'"
    capture mkdir "`workdir'\tables"

    cd "`workdir'"

    capture log close
    log using "`workdir'\t2_did_enrollments.log", replace text

    ****************************************************************************
    * Required packages
    ****************************************************************************

    capture which ftools
    if _rc ssc install ftools, replace

    capture which reghdfe
    if _rc ssc install reghdfe, replace

    capture which esttab
    if _rc ssc install estout, replace

    capture which sdid
    if _rc ssc install sdid, replace

    capture which csdid2
    if _rc {
        net install csdid2, ///
            from("https://friosavila.github.io/stpackages") replace
    }

    ****************************************************************************
    * Locate the source dataset
    ****************************************************************************

    local sourcefile ""

    capture confirm file "`project'\data\d_hsi_white_enrollment_final3.dta"
    if !_rc {
        local sourcefile "`project'\data\d_hsi_white_enrollment_final3.dta"
    }

    if "`sourcefile'" == "" {
        capture confirm file "`project'\d_hsi_white_enrollment_final3.dta"
        if !_rc {
            local sourcefile "`project'\d_hsi_white_enrollment_final3.dta"
        }
    }

    if "`sourcefile'" == "" {
        capture confirm file "`project'\data\hsi_white_enrollment_final3.dta"
        if !_rc {
            local sourcefile "`project'\data\hsi_white_enrollment_final3.dta"
        }
    }

    if "`sourcefile'" == "" {
        capture confirm file "`project'\hsi_white_enrollment_final3.dta"
        if !_rc {
            local sourcefile "`project'\hsi_white_enrollment_final3.dta"
        }
    }

    if "`sourcefile'" == "" {
        noisily display as error "Could not find the Table 2 dataset on K:."
        capture log close
        exit 601
    }

    ****************************************************************************
    * Copy locally and load
    ****************************************************************************

    copy "`sourcefile'" ///
        "`workdir'\hsi_white_enrollment_final3.dta", replace

    use "`workdir'\hsi_white_enrollment_final3.dta", clear
    compress

    confirm variable unitid year
    confirm variable hispserve hispserveyear
    confirm variable lnftfefwhitt lnftfeftotlt
    confirm variable ftfefhispt admitpct

    ****************************************************************************
    * Recreate the authors' Table 2 sample
    ****************************************************************************

    timer clear
    timer on 1

    drop if lnftfefwhitt == .
    drop if year == 1990 & hispserve == 1

    gen missingpanel = .

    sort unitid year

    bysort unitid: egen maxyear = max(year)
    bysort unitid: egen minyear = min(year)

    bysort unitid (year): replace missingpanel = 1 if ///
        year[_n-1] != year - 1 | ///
        lnftfefwhitt == . | ///
        lnftfeftotlt == .

    replace missingpanel = . if ///
        year == 1990 & ///
        lnftfefwhitt != . & ///
        lnftfeftotlt != .

    bysort unitid: egen missingpanelall = min(missingpanel)
    replace missingpanelall = 1 if maxyear != 2019 | minyear != 1990

    bysort unitid: egen alwaystreated = min(hispserve)
    bysort unitid: egen evertreated = max(hispserve)

    drop if alwaystreated == 1
    drop if missingpanelall == 1

    isid unitid year
    xtset unitid year

    * Authors' treatment coding
    gen treated = 1
    replace treated = 0 if year < hispserveyear

    * Authors' Latine-enrollment transformation
    capture drop ln2ftfefhispt
    gen ln2ftfefhispt = log(ftfefhispt + 1)

    * Authors' cohort construction
    egen gvar = csgvar(treated), tvar(year) ivar(unitid)

    * Retained from authors' code, although not used in final models
    bysort unitid: egen treatment = max(treated)

    rename treated SimpleATT

    * Freeze wildcard expansion
    unab basecovars : lnpop* lncpop*
    local basecovars `basecovars'

    * Base-sample counts
    tempvar tagbase
    egen byte `tagbase' = tag(unitid)
    count if `tagbase'
    local schools_base = r(N)
    local N_base = _N
    drop `tagbase'

    timer off 1

    ****************************************************************************
    * Optional author diagnostics
    ****************************************************************************

    if `run_author_diagnostics' == 1 {

        tab year
        tab gvar if gvar == year

        csdid2 lnftfefwhitt `basecovars', ///
            ivar(unitid) time(year) gvar(gvar) ///
            method(reg) agg(group)

        capture csdid2, clear

        xtdidregress (lnftfefwhitt `basecovars') (SimpleATT), ///
            group(unitid) time(year)
    }

    ****************************************************************************
    * Count CSDID display sample
    ****************************************************************************

    tempvar misscsdid usecsdid tagcsdid

    egen int `misscsdid' = ///
        rowmiss(unitid year gvar lnftfefwhitt `basecovars')

    gen byte `usecsdid' = (`misscsdid' == 0)

    count if `usecsdid'
    local N_csdid = r(N)

    egen byte `tagcsdid' = tag(unitid) if `usecsdid'
    count if `tagcsdid'
    local schools_csdid = r(N)

    drop `misscsdid' `usecsdid' `tagcsdid'

    eststo clear

}

* Small e-class wrapper used only to standardize the final table row.
capture program drop post_t2_result
program define post_t2_result, eclass
    args coef stderr nobs nschools dfr

    tempname b V

    matrix `b' = (`coef')
    matrix colnames `b' = ATT

    matrix `V' = (`stderr'^2)
    matrix rownames `V' = ATT
    matrix colnames `V' = ATT

    ereturn post `b' `V', obs(`nobs')
    ereturn scalar Schools = `nschools'

    if "`dfr'" != "" {
        ereturn scalar df_r = `dfr'
    }

    ereturn local cmd "post_t2_result"
end

display as text "Table 2 test run started"
display as text "Dataset: `sourcefile'"
display as text "Base sample: `schools_base' schools and `N_base' observations"
display as text "SDID placebo repetitions: `reps'"
display as text ""

********************************************************************************
* Model 1: TWFE
********************************************************************************

display as text "Running Model 1 of 5: TWFE Panel DiD..."

quietly {

    timer on 3

    reghdfe lnftfefwhitt SimpleATT `basecovars', ///
        absorb(unitid year) cluster(unitid)

    local b1 = _b[SimpleATT]
    local se1 = _se[SimpleATT]
    local n1 = e(N)
    local schools1 = e(N_clust)
    local dfr1 = e(df_r)

    post_t2_result `b1' `se1' `n1' `schools1' `dfr1'

    eststo twfe
    estimates save "`workdir'\tables\t2_twfe.ster", replace

    capture copy "`workdir'\tables\t2_twfe.ster" ///
        "`project'\t2_twfe.ster", replace

    timer off 3
}

display as result "  Complete: ATT = " %7.3f `b1' ///
    ", SE = " %7.3f `se1'

********************************************************************************
* Model 2: CSDID simple aggregation
********************************************************************************

display as text "Running Model 2 of 5: CSDID, agg(simple)..."

quietly {

    timer on 4

    csdid2 lnftfefwhitt `basecovars', ///
        ivar(unitid) time(year) gvar(gvar) ///
        method(reg) agg(simple)

    tempname b2mat V2mat
    matrix `b2mat' = e(b)
    matrix `V2mat' = e(V)

    local c2 = colnumb(`b2mat', "SimpleATT")

    if missing(`c2') | `c2' == 0 {
        local c2 = colnumb(`b2mat', "GAverage")
    }

    if (missing(`c2') | `c2' == 0) & colsof(`b2mat') == 1 {
        local c2 = 1
    }

    if missing(`c2') | `c2' == 0 {
        noisily display as error ///
            "Could not identify the CSDID ATT in e(b)."
        noisily matrix list `b2mat'
        capture log close
        exit 498
    }

    local b2 = `b2mat'[1,`c2']
    local se2 = sqrt(`V2mat'[`c2',`c2'])

    post_t2_result `b2' `se2' `N_csdid' `schools_csdid'

    eststo csdid
    estimates save "`workdir'\tables\t2_csdid.ster", replace

    capture copy "`workdir'\tables\t2_csdid.ster" ///
        "`project'\t2_csdid.ster", replace

    capture csdid2, clear

    timer off 4
}

display as result "  Complete: ATT = " %7.3f `b2' ///
    ", SE = " %7.3f `se2'
display as text ""

display as text "Interim Table 2 check"
esttab twfe csdid, ///
    cells(b(star fmt(3)) se(par fmt(3))) ///
    star(+ .10 * .05 ** .01 *** .001) ///
    stats(Schools N, fmt(%9.0fc %9.0fc) ///
        labels("Schools" "N")) ///
    coeflabels(ATT "ATT") ///
    mtitle("TWFE Panel DiD" "CSDID") ///
    nonotes modelwidth(20)

********************************************************************************
* Model 3: SDID placebo
********************************************************************************

display as text ""
display as text "Running Model 3 of 5: SDID placebo..."

quietly {

    timer on 5

    sdid lnftfefwhitt unitid year SimpleATT, vce(placebo) ///
        covariates(`basecovars') seed(1234) reps(`reps')

    local b3 = e(ATT)
    local se3 = e(se)
    local n3 = e(N)
    local schools3 = e(N_clust)

    post_t2_result `b3' `se3' `n3' `schools3'

    eststo sdid1
    estimates save "`workdir'\tables\t2_sdid1.ster", replace

    capture copy "`workdir'\tables\t2_sdid1.ster" ///
        "`project'\t2_sdid1.ster", replace

    timer off 5
}

display as result "  Complete: ATT = " %7.3f `b3' ///
    ", SE = " %7.3f `se3'

********************************************************************************
* Model 4: SDID + Latine enrollment
********************************************************************************

display as text "Running Model 4 of 5: SDID + Latine enrollment..."

quietly {

    timer on 6

    sdid lnftfefwhitt unitid year SimpleATT, vce(placebo) ///
        covariates(`basecovars' ln2ftfefhispt) ///
        seed(1234) reps(`reps')

    local b4 = e(ATT)
    local se4 = e(se)
    local n4 = e(N)
    local schools4 = e(N_clust)

    post_t2_result `b4' `se4' `n4' `schools4'

    eststo sdid2
    estimates save "`workdir'\tables\t2_sdid2.ster", replace

    capture copy "`workdir'\tables\t2_sdid2.ster" ///
        "`project'\t2_sdid2.ster", replace

    timer off 6
}

display as result "  Complete: ATT = " %7.3f `b4' ///
    ", SE = " %7.3f `se4'

********************************************************************************
* Model 5 sample and SDID + Latine + admissions
********************************************************************************

display as text "Running Model 5 of 5: SDID + Latine + admissions..."

quietly {

    timer on 7
    preserve

    * Authors' Model 5 sample restrictions
    drop if year < 2001

    drop missingpanelall
    replace missingpanel = 1 if admitpct == .

    bysort unitid: egen missingpanelall = min(missingpanel)
    drop if missingpanelall == 1

    drop alwaystreated
    bysort unitid: egen alwaystreated = min(SimpleATT)
    drop if alwaystreated == 1

    isid unitid year
    xtset unitid year

    timer off 7
    timer on 8

    sdid lnftfefwhitt unitid year SimpleATT, vce(placebo) ///
        covariates(`basecovars' ln2ftfefhispt admitpct) ///
        seed(1234) reps(`reps')

    local b5 = e(ATT)
    local se5 = e(se)
    local n5 = e(N)
    local schools5 = e(N_clust)

    post_t2_result `b5' `se5' `n5' `schools5'

    eststo sdid3
    estimates save "`workdir'\tables\t2_sdid3.ster", replace

    capture copy "`workdir'\tables\t2_sdid3.ster" ///
        "`project'\t2_sdid3.ster", replace

    timer off 8
    restore
}

display as result "  Complete: ATT = " %7.3f `b5' ///
    ", SE = " %7.3f `se5'

********************************************************************************
* Final Table 2
********************************************************************************

display as text ""
display as text "Final Table 2"

esttab twfe csdid sdid1 sdid2 sdid3, ///
    cells(b(star fmt(3)) se(par fmt(3))) ///
    star(+ .10 * .05 ** .01 *** .001) ///
    stats(Schools N, fmt(%9.0fc %9.0fc) ///
        labels("Schools" "N")) ///
    coeflabels(ATT "ATT") ///
    mtitle("TWFE" ///
           "CSDID" ///
           "SDID" ///
           "SDID + Latine" ///
           "SDID + Latine + admissions") ///
    nonotes modelwidth(20)

********************************************************************************
* Export final table and log
********************************************************************************

quietly {

    esttab twfe csdid sdid1 sdid2 sdid3 using ///
        "`workdir'\tables\t2_did_enrollments.rtf", ///
        cells(b(star fmt(3)) se(par fmt(3))) ///
        star(+ .10 * .05 ** .01 *** .001) ///
        stats(Schools N, fmt(%9.0fc %9.0fc) ///
            labels("Schools" "N")) ///
        coeflabels(ATT "ATT") ///
        mtitle("Panel DiD / TWFE" ///
               "CSDID" ///
               "SDID Placebo" ///
               "SDID Placebo Latine Control" ///
               "SDID Placebo Latine, Admissions Controls") ///
        nonotes modelwidth(20) replace

    * K: root is more reliable than a deeper tables subfolder in Virtual Sites.
    capture copy "`workdir'\tables\t2_did_enrollments.rtf" ///
        "`project'\t2_did_enrollments.rtf", replace
    local rtfcopyrc = _rc

    * Also attempt the original tables subfolder silently.
    capture mkdir "`project'\tables"
    capture copy "`workdir'\tables\t2_did_enrollments.rtf" ///
        "`project'\tables\t2_did_enrollments.rtf", replace

    * Save log after all estimation output has been written.
    log close

    capture copy "`workdir'\t2_did_enrollments.log" ///
        "`project'\t2_did_enrollments.log", replace
    local logcopyrc = _rc
}

display as text ""
display as text "Timer summary:"
timer list 1 3 4 5 6 7 8

display as text ""
if `rtfcopyrc' == 0 {
    display as result ///
        "RTF table saved to: `project'\t2_did_enrollments.rtf"
}
else {
    display as error ///
        "The RTF table was created locally but could not be copied to K:."
}

if `logcopyrc' == 0 {
    display as result ///
        "Log saved to: `project'\t2_did_enrollments.log"
}
else {
    display as error ///
        "The log was created locally but could not be copied to K:."
}
