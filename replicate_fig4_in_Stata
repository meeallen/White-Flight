****************************************************
* Figure 4 quiet replication setup
* Creates notebook-compatible data path in temp folder
****************************************************

clear all
set more off
capture log close _all
graph close _all
set graphics on

local project "K:/White Flight Data for Stata"

display as text "Setting up temporary Figure 4 workspace..."

capture confirm file "`project'/d_hsi_white_enrollment_final3.dta"
if _rc {
    display as error "Could not find:"
    display as error "`project'/d_hsi_white_enrollment_final3.dta"
    exit 601
}

local workdir "`c(tmpdir)'whiteflight_fig4_work"

capture mkdir "`workdir'"
capture mkdir "`workdir'/data"

copy "`project'/d_hsi_white_enrollment_final3.dta" ///
     "`workdir'/data/hsi_white_enrollment_final3.dta", replace

cd "`workdir'"

display as result "Temporary workspace ready:"
pwd
display as result "Author code can now use: data/hsi_white_enrollment_final3"

